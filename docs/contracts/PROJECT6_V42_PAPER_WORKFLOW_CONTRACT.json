{
  "contract_id": "PROJECT6_V42_PAPER_WORKFLOW_V1",
  "status": "FROZEN_CODE_CONTRACT",
  "created_at": "2026-07-31",
  "updated_at": "2026-08-04",
  "authoritative_for": "paper_scientific_workflow",
  "legacy_pipeline_authorizes_formal": false,
  "network_variant": "rainfall_only_no_dwf",
  "data_split_policy": {
    "authority": "rainfall_sha_or_fingerprint",
    "semantics": "current_generation_rainfall_group_holdout",
    "historical_status_is_split_gate": false,
    "hard_requirement": "zero_overlap_between_current_model_development_and_current_evaluation_roles",
    "evaluation_roles": [
      "calibration",
      "challenge",
      "locked_validation",
      "formal_blind"
    ],
    "formal_blind_legacy_stage_name_semantics": "final_current_generation_held_out_test_after_policy_lock"
  },
  "mainline_order": [
    "phase_r0",
    "step1_sparse_state_reconstruction",
    "step2_multi_reference_hydraulic_surrogate",
    "step3_pfv_budgeted_tfv_rolling_mpc",
    "step4_closed_loop_and_heldout_evaluation"
  ],
  "mainline_auditor": "sewerrtc.v4.v42_mainline_workflow.audit_v42_mainline",
  "timing": {
    "state_record_min": 5,
    "control_interval_min": 10,
    "history_min": 60,
    "history_frames": 13,
    "history_semantics": "t-60,t-55,...,t",
    "horizon_min": 120,
    "horizon_steps": 12,
    "horizon_semantics": "t+10,t+20,...,t+120"
  },
  "phase_r0": {
    "role": "project_wide_physical_swmm_evidence_pool",
    "strict_auditor": "sewerrtc.v4.v42_r0_strict.audit_existing_swmm_pool_strict",
    "strict_reusable_builder": "sewerrtc.v4.v42_reusable_pool_strict.build_reusable_paper_pool_strict",
    "full_finite_audit_required": true,
    "numeric_four_reference_alignment_required": true,
    "rainfall_series_split_isolation_required": true,
    "historical_labels_are_lineage_metadata_only": true,
    "action_authority": "actual_readback_setting",
    "missing_target_imputation_allowed": false,
    "counterfactual_requires_all_four_roles_finite": true
  },
  "step1_sparse_state_reconstruction": {
    "role": "state_estimation_only_not_policy",
    "inputs": [
      "sparse_sensor_observations",
      "sensor_mask",
      "rainfall_history",
      "network_topology",
      "historical_actual_readback_actions",
      "node_static_attributes",
      "link_static_attributes"
    ],
    "outputs": [
      "network_node_depth",
      "network_node_head",
      "network_node_filling_degree",
      "key_storage_state",
      "relevant_flow_and_state_summaries",
      "gat_uncertainty",
      "ood_score"
    ],
    "formal_reconstructor": "sewerrtc.models.temporal_sparse_gat_v42.TemporalSparseGATReconstructorV42",
    "formal_adapter": "sewerrtc.state.v42_sparse_state.build_sparse_state_estimate",
    "formal_training_action_authority": "actual_readback_setting",
    "future_hydraulic_truth_forbidden": true,
    "offline_truth_must_not_be_labelled_reconstructed": true,
    "missing_flow_must_not_be_zero_filled": true,
    "missing_ood_blocks_formal_online_control": true,
    "uncertainty_calibration_required": true,
    "ood_calibration_required": true,
    "physical_head_and_filling_are_derived_from_inp_metadata": true
  },
  "step2_multi_reference_hydraulic_surrogate": {
    "role": "hydraulic_surrogate_not_policy",
    "equation": "Y_b = F_theta(X_t-60:t, R_t:t+120, U_b, G)",
    "shared_parameters_across_branches": true,
    "branches": [
      "candidate",
      "no_control",
      "dynamic_internal",
      "hold_previous"
    ],
    "branch_semantics": {
      "candidate": "candidate MPC Engineering36 schedule",
      "no_control": "all Engineering36 facilities fully open/on, setting=1.0 throughout H120",
      "dynamic_internal": "native SWMM dynamic internal rules",
      "hold_previous": "hold current/readback setting throughout the horizon"
    },
    "branch_equivalence_policy": "real action/hydraulic equality is allowed but must be audited and reported; same-action different-hydraulic outcomes under same state/forcing fail consistency checks",
    "formal_model": "sewerrtc.v4.models_v42.hydraulic_multi_reference.MultiReferenceHydraulicSurrogate",
    "formal_loss": "sewerrtc.v4.models_v42.hydraulic_trajectory_losses.HydraulicTrajectoryLoss",
    "history_input_contract": "gat_compatible_causal_state",
    "history_input_features": [
      "network_node_depth"
    ],
    "historical_actual_readback_actions_required": true,
    "full_network_flooding_history_as_online_input": false,
    "default_target_contract": "CONTROL_CORE",
    "target_contracts": {
      "CONTROL_CORE": {
        "required_targets": [
          "node_depth",
          "node_flooding_rate",
          "storage_volume",
          "managed_facility_flow"
        ],
        "optional_targets": [
          "outfall_flow"
        ],
        "formal_claim": "control-oriented hydraulic trajectory surrogate"
      },
      "FULL_HYDRAULIC": {
        "required_targets": [
          "node_depth",
          "node_flooding_rate",
          "storage_volume",
          "managed_facility_flow",
          "outfall_flow"
        ],
        "optional_targets": [],
        "formal_claim": "extended hydraulic trajectory surrogate including explicit outfall discharge"
      }
    },
    "system_flooding_rate_sequence": "derived_from_node_flooding_rate",
    "kpi_derivation": {
      "PFV": "integral of candidate-minus-no_control priority-node flooding-rate sequence",
      "TFV": "integral of candidate-minus-dynamic_internal system flooding-rate sequence",
      "Peak": "max(candidate system flooding-rate) minus max(dynamic_internal system flooding-rate)"
    },
    "independent_free_standing_kpi_head_authoritative": false,
    "missing_reference_policy": "fail_closed_no_substitution",
    "authoritative_raw_recorder": "sewerrtc.simulation.v42_hydraulic_recorder.record_v42_hydraulic_targets",
    "fixed_train1200_or_train1600_quota_required": false,
    "missing_target_imputation_allowed": false
  },
  "step3_pfv_budgeted_tfv_rolling_mpc": {
    "selector": "sewerrtc.control.pfvfirst_mpc_v42.decide_pfvfirst_mpc",
    "control_objective_contract": "PROJECT6_V42_PFV_BUDGETED_TFV_MPC_V1",
    "hard_constraints": [
      "PFV_noninferiority_budget_vs_no_control",
      "priority_node_depth_safety",
      "K",
      "bounds",
      "rate",
      "ramp",
      "dwell",
      "interlock",
      "uncertainty",
      "OOD",
      "executability"
    ],
    "pfv_noninferiority": {
      "reference": "no_control",
      "absolute_allowance_m3": 100.0,
      "relative_allowance_fraction": 0.05,
      "decision_rule": "PFV_delta_UCB <= 100 + 0.05 * PFV_no_control"
    },
    "priority_depth_safety": {
      "nodes": "PFV_CORE8_V1",
      "limit_rule": "min(0.95 * node_max_depth, node_max_depth - 0.05m)",
      "decision_rule": "priority_depth_UCB <= node_specific_limit"
    },
    "performance_objective": "delta_TFV_DI + lambda_peak*positive(delta_Peak_DI) + lambda_action*J_action + lambda_terminal*J_terminal + lambda_uncertainty*J_uncertainty",
    "peak_is_hard_safety_constraint": false,
    "peak_positive_excess_penalty_weight_seconds": 600.0,
    "tfv_is_hard_safety_constraint": false,
    "safety_violation_can_be_compensated_by_performance": false,
    "safe_set_empty": "execute_frozen_fallback",
    "solver_or_selection_error": "execute_frozen_fallback",
    "max_changed_facilities": 8,
    "formal_evidence_requires_engineering_status_derived_from_execution": true,
    "formal_evidence_requires_changed_facilities_derived_from_executed_action": true,
    "formal_evidence_requires_actual_readback_verification": true,
    "formal_evidence_requires_calibrated_uncertainty_and_ood_lineage": true
  },
  "step4_closed_loop_and_heldout_evaluation": {
    "ordered_stages": [
      "true_state_offline_validation",
      "exact_swmm_closed_loop",
      "surrogate_closed_loop",
      "gat_integrated_closed_loop",
      "policy_lock",
      "challenge",
      "locked_validation",
      "formal_blind"
    ],
    "evaluation_semantics": "current_generation_rainfall_group_holdout",
    "historical_status_is_split_gate": false,
    "development_results_can_substitute_formal": false,
    "policy_lock_lineage": {
      "challenge_locked_and_final_must_match_policy_sha256": true,
      "challenge_locked_and_final_must_match_model_sha256": true,
      "challenge_locked_and_final_must_match_gat_model_sha256": true,
      "challenge_locked_and_final_must_match_fallback_contract_sha256": true
    },
    "challenge": {
      "minimum_events": 12,
      "current_generation_holdout_required": true,
      "current_training_overlap_required": 0,
      "post_evaluation_exclusion_allowed": false,
      "policy_lock_required_before_evaluation": true,
      "used_for_retraining": false
    },
    "locked_validation": {
      "minimum_events": 16,
      "current_generation_holdout_required": true,
      "explicit_unique_rainfall_sha_list_required": true,
      "current_training_overlap_required": 0,
      "post_evaluation_exclusion_allowed": false,
      "policy_lock_required_before_evaluation": true,
      "used_for_retraining": false,
      "one_shot": true
    },
    "formal_blind": {
      "semantic_name": "final_current_generation_held_out_test",
      "minimum_events": 24,
      "current_generation_holdout_required": true,
      "explicit_unique_rainfall_sha_list_required": true,
      "current_training_overlap_required": 0,
      "post_evaluation_exclusion_allowed": false,
      "policy_lock_required_before_evaluation": true,
      "required_authoritative_strategies": [
        "Proposed",
        "EFD",
        "Auto-RBC",
        "All-close",
        "No-control",
        "Internal",
        "Hold"
      ],
      "required_strategy_authority": "authoritative_swmm",
      "each_strategy_event_count_must_equal_formal_event_count": true
    }
  },
  "scientific_stop_conditions": [
    "do not authorize R0 until full finite, numeric four-reference alignment, and current rainfall-isolation manifests pass",
    "do not train formal Step1/Step2 on rainfall groups assigned to current Calibration/Challenge/Locked/final held-out evaluation",
    "do not train formal trajectory surrogate until strict Raw Readmission and the selected Step2 target contract pass",
    "do not run closed loop until true-state offline validation passes",
    "do not accept Step3 engineering/K/readback flags unless derived from actual projected/written/readback execution",
    "do not lock policy until exact, surrogate, and GAT-integrated closed loops pass",
    "do not use current Challenge, Locked Validation, or final held-out test groups for model-weight retraining",
    "do not claim FULL_HYDRAULIC when explicit outfall supervision is absent"
  ]
}
