{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RTC: Fast Core Smoke",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-u",
        "${workspaceFolder}/scripts/run_v42_fast_core_pipeline.py",
        "--mode",
        "smoke",
        "--seed",
        "42"
      ],
      "options": {
        "env": {
          "PYTHONUNBUFFERED": "1",
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "RTC: Fast Core Potential",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-u",
        "${workspaceFolder}/scripts/run_v42_fast_core_pipeline.py",
        "--mode",
        "potential",
        "--seed",
        "42"
      ],
      "options": {
        "env": {
          "PYTHONUNBUFFERED": "1",
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
